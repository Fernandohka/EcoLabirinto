; EcoLabirinto — Aventura pela Vida Terrestre
; Projeto Godot 4.3+; o protótipo original permanece nas pastas Map, Player, etc.
config_version=5

[application]
config/name="EcoLabirinto | Guardiões da Floresta"
run/main_scene="res://Adventure/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="Aventura 2D com exploração procedural, quatro biomas, animais e ameaças ambientais."
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=1
